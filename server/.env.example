# Backend Environment Variables
PORT=5000
NODE_ENV=production

# Frontend Client URL for CORS (your deployed Vercel / Netlify domain)
CLIENT_URL=https://your-frontend-domain.vercel.app

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sanchari?retryWrites=true&w=majority

# ========================================================
# Railway MySQL Database Configuration
# If deployed on Railway in the same project, Railway sets
# MYSQL_URL or MYSQLHOST automatically!
# ========================================================
# Option 1: Single Connection URL (Recommended by Railway)
MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway

# Option 2: Individual variables (or if connecting from local machine)
MYSQLHOST=roundhouse.proxy.rlwy.net
MYSQLUSER=root
MYSQLPASSWORD=your_railway_password
MYSQLDATABASE=railway
MYSQLPORT=12345
